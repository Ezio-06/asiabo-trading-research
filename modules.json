    {
      "key": "lab_power",
      "group": "lab",
      "name": "Lab: power (all lanes, Parts A-K)",
      "steps": [
        {
          "script": "asiabo_lab.py",
          "args": [
            "power"
          ]
        }
      ],
      "est_min": 26,
      "ram_gb": null,
      "writes": "reports\\lab_<time>\\",
      "report_prefix": "lab_",
      "vision": "wipe",
      "tidy_after": [
        "run_asiabo_lab.bat"
      ]
    },
